<?xml version="1.0"?>
<psalm
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:xi="http://www.w3.org/2001/XInclude"
	errorLevel="4"
	resolveFromConfigFile="true"
	phpVersion="8.5"
	xmlns="https://getpsalm.org/schema/config"
	xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
>
	<projectFiles>
		<directory name="src"/>
		<!-- Checks that a generic class's fluent `static` still resolves to the subclass; see
		     the file's own docblock for what silently breaks when it does not. -->
		<file name="tests/Psalm/FluentChainGuard.php"/>
		<ignoreFiles>
			<directory name="vendor"/>
			<directory name="tests/assets/snapshots"/>
			<directory name="tests/tmp"/>
		</ignoreFiles>
	</projectFiles>

	<!-- The levels every Oliup package analyses at. Nothing here is repeated below. -->
	<xi:include href="vendor/oliup/oliup-cs-php/src/psalm/handlers.xml"/>
</psalm>
