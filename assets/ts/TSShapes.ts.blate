/**
 * Every entity of this schema, by the name gobl knows it as: its morph type.
 *
 * What reads it is a build and the tools: a checker holding a definition to what the tables really
 * hold, an editor completing a column's name, a form generated for one, a dashboard that lets a
 * person work on the records themselves. A page that only draws data imports none of it -- not
 * because any of it is a secret, since the generated entity classes carry the same column names
 * already, but because a page is handed what it needs and the structure of every table is not that.
 * Which is why these live in a directory of their own, with their own index, and nothing in the
 * bundle every page imports reaches them. What a page does take is `ENTITY_DESCRIPTIONS`.
 *
 * `satisfies` and not an annotation: the literal types stay, so a tool can see which entities exist
 * and what each column is called, while a mapping that stopped being one `@oweb-io/schema` can read
 * fails this file instead of surfacing where it is used.
 */
export const ENTITY_SHAPES = {='{'}
{@each shape:name in shapes}	'{= shape.name}': {='{'}
		entity: {= shape.const}_ENTITY,
		read: {= shape.const}_SHAPE,
		write: {= shape.const}_WRITE_SHAPE,
	{='}'},
{/each}{='}'} as const satisfies EntityRegistry;

/**
 * What identifies each entity -- its table, key, label column, column types and relations -- by its
 * morph type, without the shapes of its rows.
 *
 * What a page takes to draw a picker of records: which column an id is read by and which stands for
 * a record. Each is the same constant `ENTITY_SHAPES` holds, so a bundler keeping only these
 * leaves every shape out of the page.
 */
export const ENTITY_DESCRIPTIONS = {='{'}
{@each shape:name in shapes}	'{= shape.name}': {= shape.const}_ENTITY,
{/each}{='}'} as const satisfies EntityDescriptions;
